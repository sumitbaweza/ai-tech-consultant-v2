# Copy this file to .env:   cp .env.example .env
# Nothing here is a model key: each business adds its own keys in Settings (Task 1.2).

# --- Postgres (local Docker only; change before sharing the database) ---
POSTGRES_PASSWORD=postgres
OWNER_DB_PASSWORD=owner
WEB_DB_PASSWORD=web
BRAIN_DB_PASSWORD=brain

# --- Encryption and sessions ---
# 32 random bytes, base64. Encrypts every stored key and Google token. Make one with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
SECRET_KEY=ZGV2LW9ubHktc2VjcmV0LWNoYW5nZS1tZS0wMTIzNDU=

# Where the app is opened in the browser (used for the Google sign-in callback)
PUBLIC_URL=http://localhost:8080

# --- Optional platform services ---
# Google OAuth app (Web) for connecting Gmail. Redirect URI: http://localhost:8080/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Voyage embeddings (voyage-4-lite). Empty: search uses keywords and trigrams only.
VOYAGE_API_KEY=
# The Self-Improve Loop's pull requests: a fine-grained token with Contents and Pull requests
# write access to one repo, and that repo as owner/name. Empty: branches stay local.
GITHUB_TOKEN=
GITHUB_REPO=

# A Brain API key for the MCP server (Settings > Members and API keys). Empty: its tools say so.
BRAIN_MCP_API_KEY=
# Password of the demo logins the seed makes (development only)
DEMO_PASSWORD=demo1234

# Ollama on this laptop. From inside Docker it's the host gateway; from uv run, http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434

# 1 = canned model replies, to click through the app with no key and no cost.
# Every screen then shows a banner; nothing measured in this mode is an eval result.
LLM_FAKE=false
